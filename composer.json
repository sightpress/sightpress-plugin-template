{
  "name": "sightpress/plugin-template",
  "description": "The starting point for a new SightPress plugin.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.4",
    "sightpress/plugin-core": "^1.0"
  },
  "require-dev": {
    "deptrac/deptrac": "^4.0",
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^13.0",
    "rector/rector": "^2.0",
    "sightpress/core": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "SightPress\\Plugin\\Template\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SightPress\\Plugin\\Template\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    },
    "sightpress": {
      "id": "template",
      "api": "^1.0",
      "bundle": "SightPress\\Plugin\\Template\\TemplatePlugin",
      "requires": [],
      "capabilities": {
        "template.manage": ["owner", "admin"]
      },
      "routes": [],
      "admin_routes": [],
      "locales": [
        "en-GB", "en-US", "pt-PT", "pt-BR", "es-ES", "es-419", "fr-FR",
        "fr-CA", "it-IT", "de-DE", "de-CH"
      ],
      "outbound_hosts": []
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": [
      "XDEBUG_MODE=coverage phpunit --coverage-clover var/coverage/clover.xml",
      "@php vendor/bin/sightpress-check-coverage var/coverage/clover.xml"
    ],
    "stan": "phpstan analyse --memory-limit=1G",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "rector": "rector process --dry-run",
    "deptrac": "deptrac analyse --no-progress",
    "check:licenses": "@php vendor/bin/sightpress-check-licenses",
    "check:translations": "@php vendor/bin/sightpress-check-translations translations template",
    "qa": [
      "@test:coverage",
      "@stan",
      "@cs",
      "@rector",
      "@deptrac",
      "@check:translations"
    ]
  },
  "minimum-stability": "stable"
}
