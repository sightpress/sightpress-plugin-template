{
  "name": "sightpress/plugin-template",
  "description": "Development set-up: uses the sibling checkouts of plugin-core and core. Run: COMPOSER=composer.dev.json composer install",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "repositories": [
    { "type": "path", "url": "../plugin-core", "options": { "symlink": true } },
    { "type": "path", "url": "../core", "options": { "symlink": true } }
  ],
  "require": {
    "php": "^8.4",
    "sightpress/plugin-core": "^1.0"
  },
  "require-dev": {
    "deptrac/deptrac": "^4.0",
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^13.0",
    "rector/rector": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "SightPress\\Plugin\\Template\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SightPress\\Plugin\\Template\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
